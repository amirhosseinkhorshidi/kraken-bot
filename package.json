{
  "name": "kraken-store-bot",
  "version": "1.0.0",
  "description": "Telegram bot for Kraken Store (TF2 keys / gift cards order fulfillment, verification, support tickets) — TypeScript port, grammY + SQLite + Redis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && eslint ."
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
