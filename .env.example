# Telegram
BOT_TOKEN=
ADMIN_ID=
TICKET_GROUP_ID=
ORDERS_GROUP_ID=
VERIFICATION_GROUP_ID=

# Steam
STEAM_API_KEY=

# OTP provider (voice-call OTP via s.api.ir)
OTP_TEST_MODE=false
OTP_BASE_URL=https://s.api.ir
OTP_BEARER_TOKEN=

# Database
DB_PATH=./data/kraken-store.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Webhook (leave WEBHOOK_URL empty to use long-polling instead, e.g. in dev)
WEBHOOK_URL=
WEBHOOK_PATH=/krakenGSbot
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8443

# Business hours
TIMEZONE=Asia/Tehran
BUSINESS_HOURS_START=09:30
BUSINESS_HOURS_END=24:00

# Misc
ENABLE_LOGGING=true
